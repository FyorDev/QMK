#!/usr/bin/env bash
set -e

# No spaces in filenames
if git diff --cached --name-only --diff-filter=ACMR | grep ' '; then
	echo "Filenames with spaces are not allowed"
	exit 1
fi

# Filenames allow only alphanumeric . _ - + @ ~ ! /
if git diff --cached --name-only --diff-filter=ACMR | grep -vE '^[a-zA-Z0-9._+@~!/-]+$'; then
	echo "Filenames must only contain: [a-zA-Z0-9._+@~!/-]"
	exit 1
fi

# Format and lint markdown files with rumdl
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
if [ -n "$STAGED_MD" ]; then
	echo "$STAGED_MD" | xargs rumdl fmt --disable MD013,MD028
	echo "$STAGED_MD" | xargs git add || exit 1
fi

# Format and lint bash files with shfmt and shellcheck
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACMR -- '*.sh' '.githooks/*')
if [ -n "$STAGED_SH" ]; then
	echo "$STAGED_SH" | xargs shfmt -w
	echo "$STAGED_SH" | xargs git add || exit 1
	echo "$STAGED_SH" | xargs shellcheck
fi

# No >50MB files outside of LFS
git diff --cached --name-only --diff-filter=ACMR | while read -r file; do
	[ -f "$file" ] || continue
	size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
	if [ "$size" -gt $((50 * 1024 * 1024)) ] && ! git check-attr filter "$file" | grep -q lfs; then
		echo "File $file is $((size / 1024 / 1024))MB (limit: 50MB) remove or use Git LFS"
		exit 1
	fi
done || exit 1
